  <div class="prop lead">Installations Worldwide</div>
</div>

<div class="item">
  <div class="value">700+</div>
  <div class="prop lead">Water Experts Globally</div>
</div>

<div class="item">
  <div class="value">1.6B+</div>
  <div class="prop lead">Gallons of Water Treated Daily</div>
</div>


        </div>
      </div>
    </div>
  </div>
</section>

