<section class="content-section large-padding-top large-padding-bottom">
  <div class="container">
    <div class="section-header mb-big">
      <div data-aos="fade-right" class="aos-init aos-animate"><h2>Our Work</h2></div>
      <div data-aos="fade-left" class="aos-init aos-animate"><a title="See All" class="sp-link" href="#">See All</a></div>
    </div>

    <div data-aos="fade-up" class="featured-projects-slider slick-initialized slick-slider aos-init aos-animate" data-cnt="04">

        <div class="slick-list draggable"><div class="slick-track" style="opacity: 1; width: 5472px;"><div class="item slick-slide slick-current slick-active" data-cnt="01" data-slick-index="0" aria-hidden="false" tabindex="0" style="width: 1368px; position: relative; left: 0px; top: 0px; z-index: 999; opacity: 1;">
          <div class="row">
            <div class="col-md-6 indent-right">
              <div class="image-wrap">

                  <img src="/assets-f/img/8feb8c08e33016.png" alt="ACG Revolutionizes Wastewater Treatment with Membrane Distillation Technology for Zero Liquid Discharge">

              </div>
            </div>
            <div class="col-md-6">
